{
  "name": "anylm-app",
  "version": "0.3.0",
  "description": "AnyLM desktop app: projects with context, served by local Ollama models.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node scripts/check.js",
    "fetch-chroma": "node scripts/fetch-chroma.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "Yash",
  "license": "MIT",
  "dependencies": {
    "chromadb": "^3.5.0",
    "electron-updater": "^6.3.9"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "^1.1.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.6",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.anylm.app",
    "productName": "AnyLM",
    "icon": "build/icon.png",
    "beforePack": "scripts/before-pack.js",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/chroma",
        "to": "chroma"
      }
    ],
    "asarUnpack": [
      "**/node_modules/electron-liquid-glass/**",
      "**/node_modules/chromadb*/**"
    ],
    "protocols": [
      {
        "name": "AnyLM Auth",
        "schemes": [
          "anylm"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://REPLACE-WITH-YOUR-R2-PUBLIC-URL/llmeter"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        }
      ]
    },
    "nsis": {
      "perMachine": false,
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
