# --- Server ---
PORT=3000

# --- Database (SQLite) ---
DATABASE_URL="file:./dev.db"

# --- JWT ---
# Generate strong values for production, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Where OAuth lands after success. The desktop app owns the anylm:// scheme
# and reads the tokens from the deep link. No port here, so it is port-proof.
OAUTH_SUCCESS_REDIRECT=anylm://auth/callback

# --- Google OAuth (optional) ---
# Console: https://console.cloud.google.com/apis/credentials
# Use an OAuth client of type "Desktop app". Then loopback redirects on ANY
# port are accepted, so leave GOOGLE_CALLBACK_URL unset to let the backend
# derive it from the resolved port (http://127.0.0.1:<port>/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=

# --- Microsoft OAuth (optional, for the Outlook skill connector) ---
# Azure Portal > App registrations > New. Platform "Web", redirect URI
# http://127.0.0.1:<PORT>/connectors/outlook/callback. Grant delegated
# permissions: User.Read, Calendars.ReadWrite, Mail.Read, Mail.Send.
# The Google Calendar skill reuses GOOGLE_CLIENT_ID/SECRET above — enable the
# Google Calendar API for that project and add the calendar scopes.
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# --- GitHub OAuth (optional) ---
# Settings > Developer settings > OAuth Apps
# GitHub requires an EXACT callback (port included), so pin a fixed PORT if used.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:3000/auth/github/callback
