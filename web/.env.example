# Canonical site URL (Open Graph, sitemap, robots). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://anylm.app

# GitHub repo that hosts the AnyLM releases.
NEXT_PUBLIC_GITHUB_OWNER=workvar
NEXT_PUBLIC_GITHUB_REPO=AnyLM

# Optional. A classic or fine-grained token with public_repo read access.
# Only needed to raise the GitHub API rate limit or to read a private repo.
# Server-side only, never exposed to the browser.
GITHUB_TOKEN=

# Analytics — leave empty to disable scripts locally
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_ID=

# Search Console / Bing Webmaster meta verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
