# Release / CI credentials. Copy to .env for local release builds, or set
# these as secrets in the CI provider. NOTHING here is read by the app at
# runtime and nothing here may appear in app/.env — scripts/build-env.js
# rejects these key names outright.
#
# Runtime and build configuration for the app itself lives in app/.env.
# Server-side OAuth client secrets live in firebase/functions/.env.

# --- GitHub releases (electron-builder publish) ---
GH_TOKEN=

# --- macOS code signing + notarization ---
# Developer ID Application certificate, base64-encoded .p12 and its password.
CSC_LINK=
CSC_KEY_PASSWORD=
# Notarization, App Store Connect API key (preferred over APPLE_ID).
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
APPLE_TEAM_ID=
# Alternative: Apple ID + app-specific password.
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=

# --- Windows code signing ---
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=
