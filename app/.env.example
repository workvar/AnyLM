# Desktop app build configuration. Copy to app/.env and fill in.
#
# IMPORTANT: everything in this file is compiled into the shipped binary by
# scripts/build-env.js, so treat it as PUBLIC. It holds project coordinates,
# not credentials. The build fails if a key matching SECRET / PASSWORD /
# PRIVATE / *_TOKEN / CSC_* / APPLE_* appears here.
#
# Secrets live elsewhere:
#   - server-side OAuth client secrets  -> firebase/functions/.env
#   - code-signing + publishing tokens  -> CI environment (see ../.env.example)
#   - the signed-in user's own tokens   -> OS keychain at runtime, via safeStorage

# --- Firebase (required) ---
# Console > Project settings > General > Your apps > Web app > SDK setup.
# The web API key is a project identifier, not a secret: it authorizes nothing
# on its own, firestore.rules denies all direct client access, and every read
# and write goes through the `api` Cloud Function.
ANYLM_FIREBASE_PROJECT=anylm-REPLACE-ME
ANYLM_FIREBASE_API_KEY=REPLACE-WITH-WEB-API-KEY

# --- Firebase (optional overrides) ---
# Defaults to <project>.firebaseapp.com
# ANYLM_FIREBASE_AUTH_DOMAIN=
# Hosted sign-in page + governance API origin. Defaults to https://<project>.web.app
# Point at http://127.0.0.1:5000 to run against the emulator.
# ANYLM_SITE_URL=

# --- Skill connectors (optional) ---
# Public OAuth client id for the Outlook skill. "Public client" is a real
# OAuth term, not a euphemism: Microsoft issues these without a secret and
# PKCE protects the code exchange, so shipping it is safe and intended.
# Azure Portal > App registrations > Authentication > add a "Mobile and
# desktop applications" platform with redirect http://localhost.
# Leave blank to hide the Outlook connector.
# ANYLM_MS_CLIENT_ID=
#
# There is no Google Calendar equivalent. Google requires a client secret at
# its token endpoint to issue refresh tokens, even for desktop apps using
# PKCE, so that connector needs a server. See firebase/README.md.

# --- Local services (optional) ---
# ANYLM_OLLAMA_HOST=http://127.0.0.1:11434
# ANYLM_OLLAMA_REGISTRY=https://registry.ollama.ai
# ANYLM_EMBED_MODEL=nomic-embed-text
# Default port for the local OpenAI-compatible endpoint. The user's setting
# overrides this once they change it in Settings.
# ANYLM_PROXY_PORT=3227
