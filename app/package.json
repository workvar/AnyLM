{
  "name": "anylm-app",
  "version": "0.4.0",
  "description": "AnyLM desktop app: projects with context, served by local Ollama models.",
  "main": "dist/main.js",
  "scripts": {
    "build:env": "node scripts/build-env.js",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "build:assets": "node scripts/copy-assets.js",
    "build": "bun run build:env && bun run build:main && bun run build:renderer && bun run build:assets",
    "fix:electron-bundle": "node scripts/fix-electron-bundle.js",
    "postinstall": "node scripts/fix-electron-bundle.js",
    "watch": "bun run build:env && tsc -p tsconfig.main.json --watch",
    "typecheck": "bun run build:env && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "check": "bun run typecheck",
    "test": "bun test",
    "clean": "rm -rf dist src/main/env.generated.ts",
    "start": "bun run fix:electron-bundle && bun run build && electron .",
    "fetch-chroma": "node scripts/fetch-chroma.js",
    "pack": "bun run build && electron-builder --dir",
    "dist": "bun run build && electron-builder"
  },
  "author": "Yash",
  "license": "MIT",
  "dependencies": {
    "chromadb": "^3.5.0",
    "docx": "^9.5.0",
    "electron-updater": "^6.3.9",
    "jszip": "^3.10.1",
    "mammoth": "^1.9.0",
    "posthog-node": "^5.48.1",
    "pptxgenjs": "^3.12.0"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "^1.1.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.6",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "js-yaml": "^4.1.0",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.anylm.app",
    "productName": "AnyLM",
    "icon": "build/icon.png",
    "beforePack": "scripts/before-pack.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/icon.png",
      "package.json",
      "!dist/**/*.map",
      "!**/.env",
      "!**/.env.*"
    ],
    "extraResources": [
      {
        "from": "vendor/chroma",
        "to": "chroma"
      }
    ],
    "asarUnpack": [
      "**/node_modules/electron-liquid-glass/**",
      "**/node_modules/chromadb*/**"
    ],
    "protocols": [
      {
        "name": "AnyLM Auth",
        "schemes": [
          "anylm"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "workvar",
        "repo": "AnyLM",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "perMachine": false,
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
